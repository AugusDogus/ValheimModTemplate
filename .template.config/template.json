{
  "$schema": "http://json.schemastore.org/template",
  "author": "AugusDogus",
  "classifications": [
    "Valheim",
    "BepInEx"
  ],
  "identity": "AugusDogus.ValheimMod",
  "name": "Valheim BepInEx mod",
  "shortName": "valheim-mod",
  "sourceName": "ValheimMod",
  "preferNameDirectory": true,
  "sources": [
    {
      "exclude": [
        ".git/**",
        ".template.config/**",
        "**/bin/**",
        "**/obj/**",
        "artifacts/**",
        "Environment.props",
        "node_modules/**"
      ]
    }
  ],
  "symbols": {
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "parameters": {
        "format": "yyyy"
      },
      "replaces": "2026"
    }
  }
}
